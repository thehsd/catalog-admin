# The Express API. The admin talks to it DIRECTLY — never through Next.js.
VITE_API_BASE_URL=http://localhost:4000

# The public storefront, used only to build "view this on the public site" links.
VITE_PUBLIC_WEB_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────────────
# There is deliberately NO revalidation secret here, and there never can be.
#
# Vite inlines every VITE_* variable into the JavaScript it ships to the browser. A
# secret in this file would be a secret published to every visitor. The admin does not
# need one anyway: it never calls the Next.js webhook. It PATCHes Express, and Express —
# a server, where secrets can actually be kept — calls Next.js.
# ─────────────────────────────────────────────────────────────────────────────────────
